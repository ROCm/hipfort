# @_lib@-fortran package shim, generated by rocm_add_fortran_binding().
#
# Installed at <prefix>/lib/cmake/@_lib@-fortran/@_lib@-fortran-config.cmake.
# Fortran .mod files are compiler-specific, so the real package files are
# installed under a per-compiler subdirectory,
# <prefix>/lib/fortran/<compiler>/cmake/@_lib@-fortran, which is not on CMake's
# default find_package search path. This shim lets
# find_package(@_lib@-fortran) succeed from the install prefix (e.g. /opt/rocm)
# by forwarding to the subdirectory matching the consuming project's Fortran
# compiler. It resolves the compiler at use time, so every toolchain install can
# write the same shim without conflict.

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(@_lib@-fortran_FOUND FALSE)
  set(@_lib@-fortran_NOT_FOUND_MESSAGE
      "@_lib@-fortran requires the Fortran language to be enabled before find_package(); add Fortran to project(...) or call enable_language(Fortran).")
  return()
endif()

# Must agree with rocm_fortran_compiler_dir() in ROCmFortranBinding.cmake: named
# compilers get the spelling users know them by, everything else falls back to
# the lowercased basename (which is what yields "amdflang").
set(_@_lib@_map_GNU       gfortran)
set(_@_lib@_map_Cray      ftn)
set(_@_lib@_map_IntelLLVM ifx)
set(_@_lib@_map_Intel     ifort)
set(_@_lib@_map_NVHPC     nvfortran)

if(DEFINED _@_lib@_map_${CMAKE_Fortran_COMPILER_ID})
  set(_@_lib@_fc "${_@_lib@_map_${CMAKE_Fortran_COMPILER_ID}}")
else()
  get_filename_component(_@_lib@_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_@_lib@_fc}" _@_lib@_fc)
endif()

get_filename_component(_@_lib@_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_@_lib@_real
    "${_@_lib@_prefix}/lib/fortran/${_@_lib@_fc}/cmake/@_lib@-fortran/@_lib@-fortran-config.cmake")

if(NOT EXISTS "${_@_lib@_real}")
  file(GLOB _@_lib@_toolchains
       RELATIVE "${_@_lib@_prefix}/lib/fortran"
       "${_@_lib@_prefix}/lib/fortran/*")
  set(@_lib@-fortran_FOUND FALSE)
  set(@_lib@-fortran_NOT_FOUND_MESSAGE
      "@_lib@'s Fortran binding is not installed for the compiler '${_@_lib@_fc}'. Available toolchains: ${_@_lib@_toolchains}. Rebuild the binding with this compiler (see the migration guide, 'Building one library's binding from source'), or set @_lib@-fortran_DIR to the matching lib/fortran/<compiler>/cmake/@_lib@-fortran directory.")
  return()
endif()

include("${_@_lib@_real}")

unset(_@_lib@_fc)
unset(_@_lib@_prefix)
unset(_@_lib@_real)

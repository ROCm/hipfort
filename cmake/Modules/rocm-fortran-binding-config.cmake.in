@PACKAGE_INIT@

# Config package for @_lib@'s Fortran binding, generated by
# rocm_add_fortran_binding(). It is installed beside the archive under
# lib/fortran/@_cdir@/cmake/, not at lib/cmake/, because a .mod is only
# readable by the compiler that wrote it and several toolchains' packages have
# to coexist. find_package(@_lib@-fortran) reaches this file through the
# compiler-agnostic shim at lib/cmake/@_lib@-fortran/.
#
# The C library is pulled in for you, so linking @_rfb_NAMESPACE@::@_target@
# is enough to get @_rfb_C_TARGET@ with it.

include(CMakeFindDependencyMacro)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(@_lib@-fortran_FOUND FALSE)
  set(@_lib@-fortran_NOT_FOUND_MESSAGE
      "@_lib@-fortran requires the Fortran language to be enabled before find_package(); add Fortran to project(...) or call enable_language(Fortran).")
  return()
endif()

# There is no portable Fortran module ABI, so a .mod written by one compiler
# cannot be read by another. Reaching this file with a different compiler means
# the shim was bypassed (a hand-set @_lib@-fortran_DIR, usually); say so here
# rather than let the compiler fail on an unreadable module.
if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL "@CMAKE_Fortran_COMPILER_ID@")
  set(@_lib@-fortran_FOUND FALSE)
  set(@_lib@-fortran_NOT_FOUND_MESSAGE
      "@_lib@-fortran was built with @CMAKE_Fortran_COMPILER_ID@ (@_cdir@) but is being consumed with ${CMAKE_Fortran_COMPILER_ID}; a .mod cannot be shared between compilers. Rebuild the binding with this compiler, or point @_lib@-fortran_DIR at the matching lib/fortran/<compiler>/cmake/@_lib@-fortran directory.")
  return()
endif()

find_dependency(@_rfb_C_PACKAGE@)
@_rfb_fortran_dependencies@
include("${CMAKE_CURRENT_LIST_DIR}/@_lib@-fortran-targets.cmake")

# Lets a consumer branch on whether the binding is actually available, without
# having to know where it was installed.
set(@_lib@_FORTRAN_FOUND TRUE)
